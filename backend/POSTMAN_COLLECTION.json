      "name": "2. PHQ-9 Endpoint",
      "item": [
        {
          "name": "PHQ-9 - Mild Depression",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has required fields\", function() {",
                  "  const responseData = pm.response.json();",
                  "  pm.expect(responseData).to.have.property('totalScore');",
                  "  pm.expect(responseData).to.have.property('severity');",
                  "  pm.expect(responseData).to.have.property('driftState');",
                  "  pm.expect(responseData).to.have.property('vector_id');",
                  "});",
                  "",
                  "pm.test(\"Score is between 0-27\", function() {",
                  "  const score = pm.response.json().totalScore;",
                  "  pm.expect(score).to.be.at.least(0);",
                  "  pm.expect(score).to.be.at.most(27);",
                  "});",
                  "",
                  "pm.test(\"Severity is correctly classified\", function() {",
                  "  const responseData = pm.response.json();",
                  "  const validSeverities = ['minimal', 'mild', 'moderate', 'moderately_severe', 'severe'];",
                  "  pm.expect(validSeverities).to.include(responseData.severity);",
                  "});",
                  "",
                  "const responseData = pm.response.json();",
                  "pm.environment.set(\"last_phq9_score\", responseData.totalScore);",
                  "pm.environment.set(\"last_phq9_vector_id\", responseData.vector_id);"
                ]
              }
            }
