{
  "info": {
    "name": "MindSet X - Aura Clinical Backend",
    "description": "Complete API testing collection for /chat, /phq9, /drift, and /memory/query endpoints with Qdrant verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Chat Endpoint",
      "item": [
        {
          "name": "Chat - Basic Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has required fields\", function() {",
                  "  const responseData = pm.response.json();",
                  "  pm.expect(responseData).to.have.property('reply');",
                  "  pm.expect(responseData).to.have.property('sentiment');",
                  "  pm.expect(responseData).to.have.property('message_id');",
                  "});",
                  "",
                  "pm.test(\"Sentiment score is between -1 and 1\", function() {",
                  "  const sentiment = pm.response.json().sentiment;",
                  "  pm.expect(sentiment).to.be.at.least(-1);",
                  "  pm.expect(sentiment).to.be.at.most(1);",
                  "});",
                  "",
                  "// Save message_id for next request",
                  "const responseData = pm.response.json();",
                  "pm.environment.set(\"last_chat_message_id\", responseData.message_id);",
                  "pm.environment.set(\"last_session_id\", pm.variables.get('session_id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I've been feeling overwhelmed with schoolwork and not sleeping well lately.\",\n  \"session_id\": \"{{$randomUUID}}\",\n  \"useSearch\": false,\n  \"useMaps\": false\n}"
            },
            "url": {
              "raw": "http://localhost:8000/chat",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "chat"
              ]
            }
          }
        },
        {
          "name": "Chat - With Chat History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response includes AI reply\", function() {",
                  "  const responseData = pm.response.json();",
                  "  pm.expect(responseData.reply).to.be.a('string');",
                  "  pm.expect(responseData.reply.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What strategies would help me manage my stress better?\",\n  \"session_id\": \"{{last_session_id}}\",\n  \"chat_history\": [\n    {\n      \"role\": \"user\",\n      \"text\": \"I've been feeling overwhelmed with schoolwork and not sleeping well lately.\"\n    },\n    {\n      \"role\": \"model\",\n      \"text\": \"I understand you're experiencing stress from schoolwork and sleep difficulties. Let's explore some coping strategies.\"\n    }\n  ],\n  \"useSearch\": false,\n  \"useMaps\": false\n}"
            },
            "url": {
              "raw": "http://localhost:8000/chat",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "chat"
              ]
            }
          }
        },
        {
          "name": "Chat - Negative Sentiment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Sentiment is captured for negative text\", function() {",
                  "  const sentiment = pm.response.json().sentiment;",
                  "  pm.expect(sentiment).to.be.lessThan(0);",
                  "  console.log('Negative sentiment detected: ' + sentiment);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I feel terrible and everything seems hopeless right now. Nothing is working out.\",\n  \"session_id\": \"{{$randomUUID}}\",\n  \"useSearch\": false,\n  \"useMaps\": false\n}"
            },
            "url": {
              "raw": "http://localhost:8000/chat",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8000",
              "path": [
                "chat"
              ]
            }
          }
        }
      ]
