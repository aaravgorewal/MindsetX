    {
      "name": "3. Drift Detection Endpoint",
      "item": [
        {
          "name": "Drift - Overall Analysis",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has drift analysis fields\", function() {",
                  "  const responseData = pm.response.json();",
                  "  pm.expect(responseData).to.have.property('overall_drift_score');",
                  "  pm.expect(responseData).to.have.property('overall_status');",
                  "  pm.expect(responseData).to.have.property('alert_level');",
                  "  pm.expect(responseData).to.have.property('recommendations');",
                  "});",
                  "",
                  "pm.test(\"Drift score is between 0 and 1\", function() {",
                  "  const score = pm.response.json().overall_drift_score;",
                  "  pm.expect(score).to.be.at.least(0);",
                  "  pm.expect(score).to.be.at.most(1);",
                  "});",
                  "",
                  "pm.test(\"Status is one of valid values\", function() {",
                  "  const status = pm.response.json().overall_status;",
                  "  const validStatuses = ['stable', 'drifting', 'critical_drift', 'error'];",
                  "  pm.expect(validStatuses).to.include(status);",
                  "});",
                  "",
                  "pm.test(\"Alert level is valid\", function() {",
                  "  const alert = pm.response.json().alert_level;",
                  "  const validLevels = ['green', 'yellow', 'red'];",
                  "  pm.expect(validLevels).to.include(alert);",
                  "});",
                  "",
                  "pm.test(\"Recommendations array exists\", function() {",
                  "  const responseData = pm.response.json();",
                  "  pm.expect(responseData.recommendations).to.be.an('array');",
                  "});"
                ]
