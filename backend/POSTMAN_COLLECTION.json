    {
      "name": "4. Memory Query Endpoint",
      "item": [
        {
          "name": "Memory Query - Hybrid Search",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has required fields\", function() {",
                  "  const responseData = pm.response.json();",
                  "  pm.expect(responseData).to.have.property('status');",
                  "  pm.expect(responseData).to.have.property('total_found');",
                  "  pm.expect(responseData).to.have.property('results');",
                  "  pm.expect(responseData).to.have.property('query_embedding_dim');",
                  "});",
                  "",
                  "pm.test(\"Results array contains memory items\", function() {",
                  "  const results = pm.response.json().results;",
                  "  pm.expect(results).to.be.an('array');",
                  "  if (results.length > 0) {",
                  "    const item = results[0];",
                  "    pm.expect(item).to.have.property('vector_id');",
                  "    pm.expect(item).to.have.property('similarity_score');",
                  "    pm.expect(item).to.have.property('content');",
                  "    pm.expect(item.similarity_score).to.be.at.least(0);",
                  "    pm.expect(item.similarity_score).to.be.at.most(1);",
                  "  }",
                  "});"
                ]
